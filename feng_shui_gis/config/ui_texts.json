    "goal_tomb_label": {
      "ko": "의식/무덤 공간 읽기",
      "en": "Ritual-Burial Landscape"
    },
    "goal_house_label": {
      "ko": "주거/생활 터 구성",
      "en": "Settlement Form (Domestic Landscape)"
    },
    "goal_settlement_label": {
      "ko": "고대 정착지 패턴",
      "en": "Ancient Settlement Pattern"
    },
    "goal_general_label": {
      "ko": "일반 지형 읽기",
      "en": "General Terrain Reading"
    },
    "goal_custom_label": {
      "ko": "직접 설정",
      "en": "Manual Setup"
    },
    "goal_hint_tomb": {
      "ko": "<b>의식/무덤</b> 모드입니다. 의례·묘지·제사 공간의 형세를 읽기 위해 <b>{profile}</b> 프리셋을 자동 적용합니다.",
      "en": "<b>Ritual-Burial mode</b>. The <b>{profile}</b> preset is applied automatically for landscapes associated with ritual or mortuary settings."
    },
    "goal_hint_house": {
      "ko": "<b>주거/생활</b> 모드입니다. 고대 주거지로 해석되는 장면에서 형식적 균형을 읽기 위해 <b>{profile}</b> 프리셋을 적용하고 용어 구성을 함께 봅니다.",
      "en": "<b>Settlement Form mode</b>. Applies <b>{profile}</b> to compare terrain structures for domestic/settlement form interpretation."
    },
    "goal_hint_settlement": {
      "ko": "<b>고대 정착지 패턴</b> 모드입니다. 성곽·도로축·마을 분포를 설명하는 공간 구조를 보려는 경우 <b>{profile}</b> 프리셋을 적용하고 용어 추출을 함께 제안합니다.",
      "en": "<b>Ancient Settlement Pattern mode</b> applies <b>{profile}</b> first and recommends term extraction for structural landscape reading."
    },
    "goal_hint_general": {
      "ko": "<b>일반 지형 읽기</b> 모드입니다. 전체 산줄기와 수계 흐름을 먼저 파악하는 데 맞춰 기본 프리셋을 적용합니다. 무덤 자리를 찾는다면 음택으로 바꾸는 편이 더 낫습니다.",
      "en": "<b>General terrain mode</b>. This keeps a neutral preset for reading broad ridge and hydro patterns first. If you are looking for burial sites, switch to the burial-site goal."
    },
    "goal_hint_custom": {
      "ko": "<b>직접 설정</b> 모드입니다. 고급 옵션에서 프리셋, 문화권, 시대를 직접 고르며 결과를 세밀하게 조정합니다. 현재 모델: <b>{profile}</b>.",
      "en": "<b>Manual mode</b>. Fine-tune the preset, culture, and period from Advanced Options. Current model: <b>{profile}</b>."
    },
    "context_param_label": {
      "ko": "근거 파라미터",
      "en": "Evidence Parameter"
    },
    "context_evidence_button": {
      "ko": "컨텍스트 근거 보기",
      "en": "View Context Evidence"
    },
    "guide_title": {
      "ko": "진행 가이드",
      "en": "Progress Guide"
    },
    "guide_goal_intro_tomb": {
      "ko": "<b>이 모드가 하는 일</b><br/>무덤을 쓰기 좋아 보이는 형세를 DEM에서 먼저 찾습니다. 산줄기, 물길, 혈 후보, 명당 구조를 차례대로 읽게 도와줍니다.",
      "en": "<b>What this mode does</b><br/>It looks for landform patterns that resemble suitable burial settings. Start by reading ridges, water flow, hyeol candidates, and supporting term structure from the DEM."
    },
    "guide_goal_intro_house": {
      "ko": "<b>이 모드가 하는 일</b><br/>집터나 거주지 형세를 읽기 쉽게 DEM 지형과 수계의 균형을 먼저 보여줍니다. 뒤의 보호와 앞의 개방감을 함께 살펴보는 데 맞춰져 있습니다.",
      "en": "<b>What this mode does</b><br/>It reads dwelling-site form by balancing terrain shelter and openness from DEM and hydro structure."
    },
    "guide_goal_intro_settlement": {
      "ko": "<b>이 모드가 하는 일</b><br/>고대 정착지로 추정되는 지역의 능선-수계 결합 구조와 전후·좌우 형태를 함께 읽어 공간 조직 단서를 추출합니다.",
      "en": "<b>What this mode does</b><br/>It reads ridge-hydro structure and front/back/side form together to reveal structural clues in historic settlement landscapes."
    },
    "guide_goal_intro_general": {
      "ko": "<b>이 모드가 하는 일</b><br/>풍수 전공 지식이 없어도 전체 지형 흐름을 먼저 훑어볼 수 있게 기본 산줄기와 수계를 정리합니다.",
      "en": "<b>What this mode does</b><br/>It gives a broad first pass over the landscape so users without Feng Shui background can read ridge and hydro structure before going deeper."
    },
    "guide_goal_intro_custom": {
      "ko": "<b>이 모드가 하는 일</b><br/>세부 프리셋과 컨텍스트를 직접 바꾸며 결과를 비교할 수 있습니다. 해석 목적이 분명할 때 쓰는 모드입니다.",
      "en": "<b>What this mode does</b><br/>It lets you compare results while manually changing presets and context. Use this when you already know the interpretation target."
    },
    "guide_goal_steps_tomb": {
      "ko": "<b>권장 순서</b><br/>1. DEM을 고릅니다.<br/>2. 수계를 넣거나 DEM 자동 수계를 그대로 둡니다.<br/>3. 용어 추출을 켠 상태로 지형 추출을 실행합니다.<br/>4. 혈·명당 후보를 눈으로 먼저 확인합니다.<br/>5. 점 레이어가 있으면 나중에 고급 분석 탭에서 점수 계산을 합니다.",
      "en": "<b>Recommended order</b><br/>1. Select a DEM.<br/>2. Provide a water layer or keep DEM auto-hydro on.<br/>3. Run landscape extraction with term extraction enabled.<br/>4. Inspect hyeol and myeongdang candidates first.<br/>5. If you have point data, use Advanced Analysis afterward for scoring."
    },
    "guide_goal_steps_house": {
      "ko": "<b>권장 순서</b><br/>1. DEM을 고릅니다.<br/>2. 수계를 넣거나 DEM 자동 수계를 사용합니다.<br/>3. 지형 추출로 뒤의 받침과 앞의 개방 구조를 먼저 봅니다.<br/>4. 후보 점이 있으면 고급 분석 탭에서 점수 계산을 합니다.",
      "en": "<b>Recommended order</b><br/>1. Select a DEM.<br/>2. Provide a water layer or use DEM auto-hydro.<br/>3. Run landscape extraction first to inspect shelter-behind and openness-in-front.<br/>4. If you have candidate points, score them in Advanced Analysis."
    },
    "guide_goal_steps_settlement": {
      "ko": "<b>권장 순서</b><br/>1. DEM을 고릅니다.<br/>2. 수계를 넣거나 DEM 자동 수계를 사용합니다.<br/>3. 용어 추출을 켜고 지형 추출을 실행합니다.<br/>4. 산줄기·수계 연결과 전후구조가 뚜렷한 후보를 우선 확인합니다.<br/>5. 후보 점이 있으면 고급 분석에서 점수 비교를 수행합니다.",
      "en": "<b>Recommended order</b><br/>1. Select a DEM.<br/>2. Provide a water layer or use DEM auto-hydro.<br/>3. Enable term extraction and run landscape extraction.<br/>4. Prioritize candidates with clear ridge-hydro and front/back morphology.<br/>5. If candidate points are available, compare scores in Advanced Analysis."
    },
    "guide_goal_steps_general": {
      "ko": "<b>권장 순서</b><br/>1. DEM을 고릅니다.<br/>2. 수계를 넣거나 DEM 자동 수계를 사용합니다.<br/>3. 지형 흐름 추출을 먼저 실행합니다.<br/>4. 필요할 때만 용어 점과 고급 분석으로 넘어갑니다.",
      "en": "<b>Recommended order</b><br/>1. Select a DEM.<br/>2. Provide a water layer or use DEM auto-hydro.<br/>3. Run landscape extraction first.<br/>4. Only move to term points or advanced analysis if you need more detail."
    },
    "guide_goal_steps_custom": {
      "ko": "<b>권장 순서</b><br/>1. 고급 옵션에서 목적에 맞는 프리셋을 고릅니다.<br/>2. 필요하면 문화권/시대 보정을 켭니다.<br/>3. DEM과 수계를 준비한 뒤 결과를 비교합니다.",
      "en": "<b>Recommended order</b><br/>1. Choose a preset from Advanced Options.<br/>2. Enable culture/period context if needed.<br/>3. Prepare DEM and hydro data, then compare outputs."
    },
