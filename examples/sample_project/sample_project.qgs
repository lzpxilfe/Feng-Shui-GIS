<?xml version="1.0" encoding="UTF-8"?>
<qgis projectname="Feng Shui GIS Sample Project" version="3.28.0">
  <homePath path="."/>
  <title>Feng Shui GIS Sample Project</title>
  <projectCrs>
    <spatialrefsys>
      <authid>EPSG:5186</authid>
      <description>KGD2002 / Central Belt 2010</description>
      <projectionacronym>tmerc</projectionacronym>
      <ellipsoidacronym>GRS80</ellipsoidacronym>
      <geographicflag>false</geographicflag>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group name="Sample Workflow" expanded="1">
    <customproperties/>
    <layer-tree-layer providerKey="gdal" name="sample_dem" source="./data/sample_dem.tif" checked="Qt::Checked"/>
    <layer-tree-layer providerKey="ogr" name="sample_water" source="./data/sample_water.gpkg|layername=water" checked="Qt::Checked"/>
    <layer-tree-layer providerKey="ogr" name="sample_sites" source="./data/sample_sites.gpkg|layername=sites" checked="Qt::Checked"/>
  </layer-tree-group>
  <legend updateDrawingOrder="true"/>
  <projectlayers/>
</qgis>
